# Copy this file to .env and fill it in. The .env file is not committed to git.

# Free FIRMS key for the Area API: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Pipeline data folder (raw files and ready-made Parquet)
DATA_DIR=./data

# Points for /points and /export/points.csv (default: DATA_DIR/points_serve)
# POINTS_DIR=./data/points_serve

# API address for the frontend (read as VITE_API_URL in frontend/)
VITE_API_URL=http://localhost:8000/api/v1

# Allowed frontend origins for CORS, comma-separated
CORS_ORIGINS=http://localhost:5173
