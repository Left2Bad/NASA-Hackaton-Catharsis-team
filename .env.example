# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Бесплатный ключ FIRMS для Area API: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Папка с данными пайплайна (сырые файлы и готовые Parquet)
DATA_DIR=./data

# Точки для /points и /export/points.csv (по умолчанию DATA_DIR/points_serve)
# POINTS_DIR=./data/points_serve

# Адрес API для фронтенда (в frontend/ переменная читается как VITE_API_URL)
VITE_API_URL=http://localhost:8000/api/v1

# Разрешённые адреса фронтенда для CORS, через запятую
CORS_ORIGINS=http://localhost:5173
