# Unified line endings (LF) for all text files.
# Without this, on Windows git shows whole files as modified.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff2 binary
*.parquet binary
*.duckdb binary
