.env
.env.*
!.env.example

# --- Python (pipeline/, backend/, contract/tools/) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# --- Frontend (frontend/) ---
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# --- Local databases and large files ---
*.duckdb
*.duckdb.wal
*.parquet
*.zip

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
